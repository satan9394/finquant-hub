# DeepSeek API（实际密钥写入 .env，.env 已被 gitignore）
DEEPSEEK_API_KEY=your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEFAULT_MODEL=deepseek-v4-flash

# Daily research scheduler (disabled unless explicitly enabled)
SCHEDULER_ENABLED=false
SCHEDULER_CONCURRENCY=2
SCHEDULER_MAX_TARGETS=20
SCHEDULER_HOUR=18
SCHEDULER_MINUTE=0

# Optional market-review delivery. Keep disabled until the operator explicitly approves outbound sends.
EXTERNAL_SENDERS_ENABLED=false
WECOM_WEBHOOK_URL=
FEISHU_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_SSL=true

# News search provider priority. Paid providers are skipped unless their key exists;
# Sina remains the zero-config fallback. SearXNG should point to an operator-owned instance.
NEWS_SEARCH_PROVIDERS=tavily,serpapi,bocha,brave,searxng,sina
TAVILY_API_KEY=
SERPAPI_API_KEY=
BOCHA_API_KEY=
BRAVE_SEARCH_API_KEY=
SEARXNG_BASE_URL=

# Optional A-share fundamentals fallback. AkShare is used when installed;
# Tushare additionally requires its package and a sufficiently privileged token.
TUSHARE_TOKEN=
