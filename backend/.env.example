# DeepSeek API（实际密钥写入 .env，.env 已被 gitignore）
DEEPSEEK_API_KEY=your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEFAULT_MODEL=deepseek-v4-flash
# Optional explicit HTTP proxy for LLM traffic. When set, it overrides generic
# HTTP_PROXY / HTTPS_PROXY inherited from the desktop environment.
LLM_PROXY_URL=
# Optional proxy used only by Google News RSS. Sina keeps a direct connection.
NEWS_PROXY_URL=

# Public auth and encrypted user credentials. Generate MASTER_KEY with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENV=development
MASTER_KEY=
AUTH_COOKIE_SECURE=false
# Public deployment must set APP_ENV=production, AUTH_COOKIE_SECURE=true,
# MASTER_KEY, SMTP_HOST, and SMTP_FROM. Keep backend port private behind Nginx.

# Daily research scheduler (disabled unless explicitly enabled)
SCHEDULER_ENABLED=false
SCHEDULER_CONCURRENCY=2
SCHEDULER_MAX_TARGETS=20
SCHEDULER_HOUR=18
SCHEDULER_MINUTE=0

# Optional market-review delivery. Keep disabled until the operator explicitly approves outbound sends.
EXTERNAL_SENDERS_ENABLED=false
WECOM_WEBHOOK_URL=
FEISHU_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_SSL=true

# News search provider priority. Paid providers are skipped unless their key exists;
# Google News RSS is the zero-config fallback. SearXNG should point to an operator-owned instance.
NEWS_SEARCH_PROVIDERS=tavily,serpapi,bocha,brave,searxng,google_news,sina
TAVILY_API_KEY=
SERPAPI_API_KEY=
BOCHA_API_KEY=
BRAVE_SEARCH_API_KEY=
SEARXNG_BASE_URL=

# Optional A-share fundamentals fallback. AkShare is used when installed;
# Tushare additionally requires its package and a sufficiently privileged token.
TUSHARE_TOKEN=
