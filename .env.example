# Docker Compose public deployment. Do not commit the populated .env file.
MASTER_KEY=
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true

# Absolute host paths to a certificate chain and its private key.
TLS_CERT_PATH=/etc/letsencrypt/live/quant.example.com/fullchain.pem
TLS_KEY_PATH=/etc/letsencrypt/live/quant.example.com/privkey.pem
HTTP_PORT=80
HTTPS_PORT=443

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEFAULT_MODEL=deepseek-v4-flash
SCHEDULER_ENABLED=false
